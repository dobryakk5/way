[Unit]
Description=PUT anonymous identity for nginx auth_request
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/py/way/server
EnvironmentFile=/etc/put-api.env
ExecStart=/opt/node22/bin/node dist/identity.js
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# the server listens on 0.0.0.0 and the host has no firewall: only loopback traffic may reach it
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
