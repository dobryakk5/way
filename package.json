{
  "name": "put-game-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run content:check && npm run typecheck && npm test",
    "content:check": "node --import tsx scripts/check-content.ts",
    "simulate": "node --import tsx scripts/simulate.ts",
    "smoke:phase4": "node --import tsx scripts/smoke-phase4.ts",
    "simulate:development": "node --import tsx scripts/simulate-development.ts",
    "simulate:profile": "node --import tsx scripts/simulate-profile.ts",
    "profile:calibration": "node --import tsx scripts/profile-calibration.ts",
    "profile:proposals": "node --import tsx scripts/profile-proposals.ts reports/profile-vectors-before-tuning.json",
    "v25:parse": "node --import tsx scripts/v25/parse-package.ts",
    "v25:source": "node --import tsx scripts/v25/source-checks.ts",
    "v25:simulate": "node --import tsx scripts/v25/simulate-package.ts",
    "v25:build": "node --import tsx scripts/v25/build-cards.ts"
  },
  "dependencies": {
    "framer-motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
